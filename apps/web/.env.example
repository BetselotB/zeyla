# Frontend env — copy to apps/web/.env.local
# Only VITE_* vars reach the browser. Never put a secret key here.
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chapa public (publishable) key — the secret key stays server-side only.
VITE_CHAPA_PUBLIC_KEY=

# Maps default to Leaflet + OpenStreetMap tiles, which need no token.
# Only set this if discovery/tracking switch to Mapbox tiles.
# VITE_MAPBOX_TOKEN=
