# Local defaults — copy to apps/api/.env (never commit secrets)
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://zeyla:zeyla@localhost:5432/zeyla
REDIS_URL=redis://localhost:6379

# Supabase Auth (Hrs 0–2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chapa payments — escrow funding + payout (Hrs 9–13)
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_API_BASE=https://api.chapa.co/v1
CHAPA_ENCRYPTION_KEY=
# The "Secret hash" from the Chapa dashboard's webhook settings — this is what
# the webhook HMAC is computed with, not CHAPA_ENCRYPTION_KEY above.
CHAPA_WEBHOOK_SECRET=

# Must-have integrations (wire during hackathon)
FAL_KEY=

# High / medium priority (Hrs 19–22)
ELEVENLABS_API_KEY=
FIRECRAWL_API_KEY=

# Demo mode: simulate Chapa webhooks + GPS animation
DEMO_MODE=true

# --- Marketplace & Realtime module (owner: @mohammed) ------------------------
# Voice request pipeline, in the order it runs:
#   1. Addis AI /api/v2/stt transcribes the clip. It is trained on Amharic and
#      Afaan Oromo, which is why it beats a generic STT here.
#   2. Gemini translates that transcript to English and extracts the
#      {category, urgency, location} the matcher needs, then ranks the nearby
#      providers it should pair the customer with.
#   3. An offline keyword parser catches everything if both are down.
# Every key is optional and every stage degrades to the next, so a missing key
# or a dead API slows the demo down but never fails it.
WHISPERFLOW_API_KEY=
WHISPERFLOW_API_BASE=https://api.whisperflow.ai/v1
ADDIS_AI_API_KEY=
ADDIS_AI_API_BASE=https://api.addisassistant.com
ADDIS_AI_MODEL=Addis-፩-አሌፍ

# Gemini authenticates with ?key=, not a bearer token. An OAuth-style token
# (AQ.…) works here; a bearer header does not.
#
# Free-tier quota is counted per model per day, so when the log shows Gemini
# 429ing and parsing dropping to keywords, move to the next model rather than
# hunting for a new key: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-2.5-pro.
# Any Gemini 3 model is fine — the client adjusts the thinking setting itself,
# which the two families spell differently.
GEMINI_API_KEY=
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Identity & Money module (owner: @betselot) ------------------------------
# Where this API and the web app are reachable — used to build Chapa's
# callback_url (server) and return_url (browser).
PUBLIC_API_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# mock = this API generates and checks OTP codes (no SMS bill during the
# hackathon). supabase = delegate phone OTP to Supabase.
AUTH_OTP_PROVIDER=mock
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_SESSION_TTL_HOURS=72

# KYC uploads land on local disk (gitignored). Swap for Supabase Storage later.
KYC_UPLOAD_DIR=./uploads
KYC_MAX_UPLOAD_BYTES=5242880
# Hackathon shortcut — no biometric match, uploads are verified on arrival.
KYC_AUTO_VERIFY=true

# Escrow economics + admin release/refund guard.
PLATFORM_FEE_PERCENT=5
ADMIN_API_KEY=

# Receipt address used at checkout when a user has no email on file. Chapa
# validates the domain's MX records, so a made-up domain is rejected — this
# must be a real, deliverable mailbox. Max 50 characters.
CHAPA_FALLBACK_EMAIL=
